{
  "name": "pcesports.com",
  "description": "PCesports: esports for people who don't have time to follow everything",
  "version": "6.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxorlovsky/pcesports.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && stylelint \"app/**/*.{css,vue}\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:build": "node tools/check-build.mjs .output/public",
    "check": "npm run lint && npm run typecheck && npm test && npm run generate && npm run check:build",
    "nginx:test": "sh tools/nginx/test.sh",
    "deploy": "node tools/deploy/deploy.mjs"
  },
  "pre-commit": [
    "lint"
  ],
  "git-commit-hook": {
    "types": [
      "feat",
      "fix",
      "chore",
      "docs",
      "refactor",
      "style",
      "test",
      "revert",
      "merge",
      "balance"
    ],
    "lineLength": 120
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "git-commit-msg": "^0.3.0",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.0",
    "pre-commit": "^2.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "git-commit-msg@0.3.0": true,
    "pre-commit@2.0.0": true
  }
}
